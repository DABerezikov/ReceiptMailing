<Window x:Class="ReceiptMailing.Views.Windows.ImportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ReceiptMailing.Models"
        Title="{Binding Title}"
        Width="960" Height="640"
        MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding Status}"/>
        </StatusBar>

        <!-- Нижняя панель с кнопками -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderColorBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Прогресс во время применения -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Width="200" Height="6" IsIndeterminate="True"
                                 Background="{StaticResource BorderColorBrush}"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 BorderThickness="0" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="Применить выбранное"
                            Width="180" Margin="0,0,8,0"
                            Command="{Binding ApplyCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Отмена" Width="100"
                            Command="{Binding CancelCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <Grid Margin="16,12,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Сводка -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Background="{StaticResource SuccessLightBrush}"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Новых: " Foreground="{StaticResource SuccessBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NewCount}" Foreground="{StaticResource SuccessBrush}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="#FEF3C7"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Изменённых: " Foreground="{StaticResource WarningBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ChangedCount}" Foreground="{StaticResource WarningBrush}"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource BorderColorBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Идентичных (пропущено): "
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding IdenticalCount}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Тулбар выбора -->
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Выбрать все" Height="30" Padding="12,0" Margin="0,0,6,0"
                        Command="{Binding SelectAllCommand}"/>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Снять выбор" Height="30" Padding="12,0" Margin="0,0,6,0"
                        Command="{Binding DeselectAllCommand}"/>
                <TextBlock Text="(щёлкните по строке, чтобы увидеть изменения)"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Таблица записей -->
            <DataGrid Grid.Row="4"
                      ItemsSource="{Binding Entries}"
                      SelectionMode="Single"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      IsReadOnly="True"
                      AutoGenerateColumns="False">

                <DataGrid.Columns>

                    <!-- Чекбокс выбора для импорта -->
                    <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="✓" HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Номер участка -->
                    <DataGridTextColumn Header="Номер участка" Width="130"
                                        Binding="{Binding Imported.Number}"/>

                    <!-- Садовод -->
                    <DataGridTextColumn Header="Садовод" Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="Imported.Gardener"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>

                    <!-- Статус (Новый / Изменён) -->
                    <DataGridTemplateColumn Header="Статус" Width="100" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{StaticResource SuccessLightBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="{x:Static models:ImportStatus.Changed}">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}"
                                                                 Value="{x:Static models:ImportStatus.Changed}">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Изменённые поля -->
                    <DataGridTextColumn Header="Изменённые поля" Width="*"
                                        Binding="{Binding DiffSummary, Mode=OneWay}"/>
                </DataGrid.Columns>

                <!-- Детали: список изменённых полей (только для Changed-записей) -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Margin="44,4,0,8" Padding="0"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                BorderBrush="{StaticResource BorderColorBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Visibility="{Binding HasDiffs, Converter={StaticResource BoolToVis}}">
                            <StackPanel>

                                <!-- Заголовок -->
                                <Grid Height="30"
                                      Background="{StaticResource DataGridHeaderBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Поле"
                                               FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="10,0"/>
                                    <TextBlock Grid.Column="1" Text="Изменение"
                                               FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="10,0"/>
                                </Grid>

                                <!-- Строки -->
                                <ItemsControl ItemsSource="{Binding Differences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        BorderBrush="{StaticResource BorderColorBrush}"
                                                        BorderThickness="0,0,1,1">
                                                    <TextBlock Text="{Binding Field}"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="10,4"/>
                                                </Border>
                                                <Border Grid.Column="1"
                                                        BorderBrush="{StaticResource BorderColorBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="10,4">
                                                        <TextBlock Text="{Binding OldValue}"
                                                                   Foreground="{StaticResource DangerBrush}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="  →  "
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding NewValue}"
                                                                   Foreground="{StaticResource SuccessBrush}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>

            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
