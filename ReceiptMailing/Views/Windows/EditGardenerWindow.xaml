<Window x:Class="ReceiptMailing.Views.Windows.EditGardenerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        Title="{Binding Title}"
        SizeToContent="Height"
        Width="860"
        MinWidth="700"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: ФИО + Паспорт -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ФИО -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                               Style="{StaticResource SectionHeaderStyle}" Text="ЛИЧНЫЕ ДАННЫЕ"/>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Фамилия"/>
                        <TextBox Text="{Binding SurName}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Имя"/>
                        <TextBox Text="{Binding Name}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Отчество"/>
                        <TextBox Text="{Binding Patronymic}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Паспорт -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок + глаз -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="ПАСПОРТ"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <Button ToolTip="Показать / скрыть паспортные данные"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Command="{Binding TogglePassportVisibilityCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="fa5:Awesome.Content" Value="Solid_Eye"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPassportVisible}" Value="True">
                                            <Setter Property="fa5:Awesome.Content" Value="Solid_EyeSlash"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Серия"/>
                        <TextBox Text="{Binding PassportSeries, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Номер"/>
                        <TextBox Text="{Binding PassportNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 1: Контакты + Счёт -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Контакты -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5"
                               Style="{StaticResource SectionHeaderStyle}" Text="КОНТАКТЫ"/>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Телефон"/>
                        <TextBox Text="{Binding PhoneNumber}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Основной Email"/>
                        <TextBox Text="{Binding FirstEmailAddress}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Доп. Email"/>
                        <TextBox Text="{Binding SecondEmailAddress}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Счёт -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                               Style="{StaticResource SectionHeaderStyle}" Text="РЕКВИЗИТЫ"/>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Лицевой счёт"/>
                        <TextBox Text="{Binding Account}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Документ о приёме"/>
                        <TextBox Text="{Binding Document}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Адрес проживания -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"
                           Style="{StaticResource SectionHeaderStyle}" Text="АДРЕС ПРОЖИВАНИЯ"/>

                <!-- Строка 1: Индекс, Область, Округ/Район, Нас. пункт -->
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Индекс"/>
                    <TextBox Text="{Binding PostalCode}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Область"/>
                    <TextBox Text="{Binding Province}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Округ / Район"/>
                    <TextBox Text="{Binding Region}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="6">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Населённый пункт"/>
                    <TextBox Text="{Binding City}"/>
                </StackPanel>

                <!-- Строка 2: Улица, Дом, Корпус, Квартира -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Улица"/>
                    <TextBox Text="{Binding Street}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="4">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Дом"/>
                    <TextBox Text="{Binding House}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="6">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Корпус / Кв."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Building}"/>
                        <TextBox Grid.Column="2" Text="{Binding Room}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 3: Адрес прописки -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок + чекбокс "Совпадают" -->
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7"
                            Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="АДРЕС ПРОПИСКИ" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <CheckBox Content="Совпадает с адресом проживания"
                              IsChecked="{Binding IsAddressMatched}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Строка 1 -->
                <StackPanel Grid.Row="1" Grid.Column="0"
                            IsEnabled="{Binding IsPostAddressEditable}">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Индекс"/>
                    <TextBox Text="{Binding PostPostalCode}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2"
                            IsEnabled="{Binding IsPostAddressEditable}">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Область"/>
                    <TextBox Text="{Binding PostProvince}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="4"
                            IsEnabled="{Binding IsPostAddressEditable}">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Округ / Район"/>
                    <TextBox Text="{Binding PostRegion}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="6"
                            IsEnabled="{Binding IsPostAddressEditable}">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Населённый пункт"/>
                    <TextBox Text="{Binding PostCity}"/>
                </StackPanel>

                <!-- Строка 2 -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                            IsEnabled="{Binding IsPostAddressEditable}">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Улица"/>
                    <TextBox Text="{Binding PostStreet}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="4"
                            IsEnabled="{Binding IsPostAddressEditable}">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Дом"/>
                    <TextBox Text="{Binding PostHouse}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="6"
                            IsEnabled="{Binding IsPostAddressEditable}">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Корпус / Кв."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding PostBuilding}"/>
                        <TextBox Grid.Column="2" Text="{Binding PostRoom}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 4: Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Content="Сохранить" Width="130" IsDefault="True"
                    Margin="0,0,10,0"
                    Command="{Binding AcceptCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Style="{StaticResource SecondaryButtonStyle}"
                    Content="Отменить" Width="130" IsCancel="True"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

    </Grid>
</Window>
