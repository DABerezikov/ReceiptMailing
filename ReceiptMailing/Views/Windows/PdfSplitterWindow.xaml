<Window x:Class="ReceiptMailing.Views.Windows.PdfSplitterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        xmlns:l="clr-namespace:ReceiptMailing"
        DataContext="{Binding PdfSplitterWindowModel, Source={StaticResource Locator}}"
        Title="{Binding Title}"
        Width="580" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>

        <!-- Menu -->
        <Menu IsMainMenu="True">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="Файл">
                <MenuItem Header="Настройки почты" Command="{StaticResource MailSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Выход"            Command="{StaticResource CloseWindowCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar>
            <StatusBarItem Content="{Binding Status}"/>
        </StatusBar>

        <!-- Content -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
            </Grid.RowDefinitions>

            <!-- Блок 1: Исходный PDF -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderStyle}"
                               Text="ФАЙЛ С КВИТАНЦИЯМИ"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource BorderColorBrush}"
                                BorderThickness="1" CornerRadius="5"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                Padding="8,0">
                            <TextBlock Text="{Binding PdfFilePath}"
                                       VerticalAlignment="Center"
                                       Height="32"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32"
                                fa5:Awesome.Content="Solid_FilePdf"
                                Foreground="{StaticResource IndianRedBrush}"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                ToolTip="Выбрать PDF с квитанциями"
                                Command="{Binding OpenPdfCommand}"/>
                    </Grid>

                    <!-- Прогресс разделения -->
                    <StackPanel Grid.Row="3"
                                Visibility="{Binding IsSplitting, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Height="6"
                                     Value="{Binding SplitProgress}" Maximum="100"
                                     Background="{StaticResource BorderColorBrush}"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{Binding SplitProgressText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="4" Height="10"
                            Visibility="{Binding IsSplitting, Converter={StaticResource BoolToVis}}"/>

                    <Button Grid.Row="5" Style="{StaticResource PrimaryButtonStyle}"
                            Content="Разделить по страницам"
                            HorizontalAlignment="Right"
                            Command="{Binding SplitPdfCommand}"/>
                </Grid>
            </Border>

            <!-- Блок 2: Папка для рассылки -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderStyle}"
                               Text="ПАПКА С РАЗДЕЛЁННЫМИ КВИТАНЦИЯМИ"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource BorderColorBrush}"
                                BorderThickness="1" CornerRadius="5"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                Padding="8,0">
                            <TextBox Text="{Binding SplitFilePath, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     Height="32" VerticalContentAlignment="Center"
                                     Padding="0"/>
                        </Border>

                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32"
                                fa5:Awesome.Content="Regular_FolderOpen"
                                Foreground="{StaticResource WarningBrush}"
                                Background="{StaticResource SurfaceSecondaryBrush}"
                                ToolTip="Выбрать папку с квитанциями"
                                Command="{Binding OpenFolderCommand}"/>
                    </Grid>

                    <!-- Прогресс рассылки -->
                    <StackPanel Grid.Row="3"
                                Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Height="6"
                                     Value="{Binding SendProgress}" Maximum="100"
                                     Background="{StaticResource BorderColorBrush}"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{Binding SendProgressText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="4" Height="10"
                            Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}"/>

                    <Button Grid.Row="5" Style="{StaticResource PrimaryButtonStyle}"
                            Content="Разослать квитанции"
                            HorizontalAlignment="Right"
                            Command="{Binding SendReceiptCommand}"/>
                </Grid>
            </Border>

        </Grid>
    </DockPanel>
</Window>
