<Window x:Class="ReceiptMailing.Views.Windows.SendMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="980" Height="700"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <DockPanel>

        <!-- Menu -->
        <Menu DockPanel.Dock="Top" IsMainMenu="True">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Command="{Binding CancelCommand}"/>
            </MenuItem>
        </Menu>

        <!--
            Плоская сетка: каждая зона — прямой дочерний элемент.
            Строки 0-4 делят вертикальное пространство редактора.
            Панель получателей охватывает строки 0-4 через RowSpan.
        -->
        <Grid Margin="12,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>    <!-- 0: Тема (margin 12 + TextBox 32) -->
                <RowDefinition Height="28"/>    <!-- 1: заголовок СООБЩЕНИЕ (margin 10+4 + text 14) -->
                <RowDefinition Height="3*"/>    <!-- 2: текст сообщения -->
                <RowDefinition Height="26"/>    <!-- 3: заголовок ПОДПИСЬ (margin 8+4 + text 14) -->
                <RowDefinition Height="1*"/>    <!-- 4: подпись -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="130"/>   <!-- 6: вложения -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="3"/>     <!-- 8: прогресс -->
                <RowDefinition Height="8"/>
                <RowDefinition Height="36"/>    <!-- 10: кнопки -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Панель получателей (строки 0-4, кол. 0) ===== -->
            <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeaderStyle}"
                               Text="ПОЛУЧАТЕЛИ"/>

                    <TextBlock DockPanel.Dock="Top" Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Выбрано (с email): {0} / {1}">
                                <Binding Path="SelectedWithEmailCount"/>
                                <Binding Path="TotalWithEmailCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Margin="0,6,0,0">
                        <Button Content="Выбрать всех"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectAllCommand}"
                                Margin="0,0,6,0"/>
                        <Button Content="Снять всех"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DeselectAllCommand}"/>
                    </StackPanel>

                    <ListBox Margin="0,8,0,0"
                             ItemsSource="{Binding Gardeners}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,3"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding HasEmail}"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding EmailDisplay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>
            </Border>

            <!-- ===== Фон правой панели (строки 0-4, кол. 2) — только визуальная рамка ===== -->
            <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderColorBrush}"
                    CornerRadius="8"
                    BorderThickness="1"/>

            <!-- Тема (строка 0, кол. 2) -->
            <Grid Grid.Row="0" Grid.Column="2" Margin="12,12,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource FormLabelStyle}"
                           VerticalAlignment="Center"
                           Text="Тема:"/>
                <TextBox Grid.Column="2"
                         Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- Заголовок СООБЩЕНИЕ (строка 1, кол. 2) -->
            <TextBlock Grid.Row="1" Grid.Column="2"
                       Margin="12,10,12,4"
                       Style="{StaticResource SectionHeaderStyle}"
                       Text="СООБЩЕНИЕ"/>

            <!-- Текст сообщения (строка 2, кол. 2) — 3* -->
            <!-- Height="Auto" перебивает глобальный стиль Height="32", позволяя строке растянуться -->
            <TextBox Grid.Row="2" Grid.Column="2"
                     Height="Auto"
                     Margin="12,0"
                     Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     FontFamily="Segoe UI"
                     FontSize="13"/>

            <!-- Заголовок ПОДПИСЬ (строка 3, кол. 2) -->
            <TextBlock Grid.Row="3" Grid.Column="2"
                       Margin="12,8,12,4"
                       Style="{StaticResource SectionHeaderStyle}"
                       Text="ПОДПИСЬ"/>

            <!-- Подпись (строка 4, кол. 2) — 1* -->
            <!-- Height="Auto" перебивает глобальный стиль Height="32" -->
            <TextBox Grid.Row="4" Grid.Column="2"
                     Height="Auto"
                     Margin="12,0,12,12"
                     Text="{Binding Signature, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     FontFamily="Segoe UI"
                     FontSize="13"/>

            <!-- ===== Вложения (строка 6, все колонки) ===== -->
            <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Style="{StaticResource SectionHeaderStyle}"
                               Text="ВЛОЖЕНИЯ"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <Button Content="+ Добавить"
                                Style="{StaticResource AddButtonStyle}"
                                Command="{Binding AddAttachmentCommand}"
                                Margin="0,0,6,0"/>
                        <Button Content="Удалить"
                                Style="{StaticResource DeleteButtonStyle}"
                                Command="{Binding RemoveAttachmentCommand}"/>
                    </StackPanel>

                    <ListBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                             ItemsSource="{Binding Attachments}"
                             SelectedItem="{Binding SelectedAttachment}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ===== Прогресс (строка 8) ===== -->
            <ProgressBar Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                         IsIndeterminate="True"
                         Height="3"
                         Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}"/>

            <!-- ===== Кнопки (строка 10) ===== -->
            <Grid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Сохранить умолчания"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SaveDefaultsCommand}"
                            Margin="0,0,12,0"
                            ToolTip="Сохранить тему и подпись как значения по умолчанию"/>
                    <TextBlock Text="{Binding SendStatus}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Отмена"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Отправить"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SendCommand}"/>
                </StackPanel>
            </Grid>

        </Grid>
    </DockPanel>
</Window>
