<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:p="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== BASE ===== -->
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" p:Freeze="true"/>
    <SolidColorBrush x:Key="BlackBrush" Color="Black" p:Freeze="true"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="White" p:Freeze="true"/>

    <!-- ===== PRIMARY (Blue) ===== -->
    <SolidColorBrush x:Key="PrimaryBrush"       Color="#2563EB" p:Freeze="true"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"  Color="#3B82F6" p:Freeze="true"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"   Color="#1D4ED8" p:Freeze="true"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"  Color="#DBEAFE" p:Freeze="true"/>
    <SolidColorBrush x:Key="PrimaryFocusBrush"  Color="#93C5FD" p:Freeze="true"/>

    <!-- ===== BACKGROUND / SURFACE ===== -->
    <SolidColorBrush x:Key="BackgroundBrush"         Color="#F1F5F9" p:Freeze="true"/>
    <SolidColorBrush x:Key="SurfaceBrush"            Color="#FFFFFF"  p:Freeze="true"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush"   Color="#F8FAFC"  p:Freeze="true"/>

    <!-- ===== BORDERS ===== -->
    <SolidColorBrush x:Key="BorderColorBrush"      Color="#E2E8F0" p:Freeze="true"/>
    <SolidColorBrush x:Key="BorderHoverBrush"      Color="#CBD5E1" p:Freeze="true"/>

    <!-- ===== TEXT ===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#1E293B" p:Freeze="true"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#64748B" p:Freeze="true"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="#94A3B8" p:Freeze="true"/>

    <!-- ===== SEMANTIC ===== -->
    <SolidColorBrush x:Key="SuccessBrush"       Color="#16A34A" p:Freeze="true"/>
    <SolidColorBrush x:Key="SuccessLightBrush"  Color="#DCFCE7" p:Freeze="true"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="#DC2626" p:Freeze="true"/>
    <SolidColorBrush x:Key="DangerHoverBrush"   Color="#EF4444" p:Freeze="true"/>
    <SolidColorBrush x:Key="DangerLightBrush"   Color="#FEE2E2" p:Freeze="true"/>
    <SolidColorBrush x:Key="WarningBrush"       Color="#D97706" p:Freeze="true"/>

    <!-- ===== DATAGRID ===== -->
    <SolidColorBrush x:Key="DataGridHeaderBrush"       Color="#F1F5F9" p:Freeze="true"/>
    <SolidColorBrush x:Key="DataGridAlternateRowBrush" Color="#F1F5F9"  p:Freeze="true"/>
    <SolidColorBrush x:Key="DataGridHoverRowBrush"     Color="#DBEAFE"  p:Freeze="true"/>
    <SolidColorBrush x:Key="DataGridSelectedRowBrush"  Color="#DBEAFE"  p:Freeze="true"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush"     Color="#E2E8F0"  p:Freeze="true"/>

    <!-- ===== LEGACY (kept for compatibility) ===== -->
    <SolidColorBrush x:Key="RedBrush"        Color="Red"        p:Freeze="true"/>
    <SolidColorBrush x:Key="IndianRedBrush"  Color="IndianRed"  p:Freeze="true"/>
    <SolidColorBrush x:Key="GreenBrush"      Color="#16A34A"    p:Freeze="true"/>
    <SolidColorBrush x:Key="BlueBrush"       Color="#2563EB"    p:Freeze="true"/>
    <SolidColorBrush x:Key="LightGrayBrush"  Color="#E2E8F0"    p:Freeze="true"/>
    <SolidColorBrush x:Key="GrayBrush"       Color="#94A3B8"    p:Freeze="true"/>
    <SolidColorBrush x:Key="DarkGrayBrush"   Color="#64748B"    p:Freeze="true"/>
    <SolidColorBrush x:Key="OrangeBrush"     Color="#D97706"    p:Freeze="true"/>
    <SolidColorBrush x:Key="OrangeRedBrush"  Color="OrangeRed"  p:Freeze="true"/>
    <SolidColorBrush x:Key="DarkBrush"       Color="#1E293B"    p:Freeze="true"/>

</ResourceDictionary>
